{
    "name": "adminpanel/bulk-upload",
    "description": "Admin Panel with Bulk Upload Feature",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^1.29",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "AdminPanel\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
} 